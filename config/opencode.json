{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    }
  },
  "provider": {
    "fastflowlm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FastFlowLM (local NPU)",
      "options": {
        "baseURL": "http://fastflowlm:52625/v1",
        "apiKey": "{env:OPENAI_API_KEY}",
        "timeout": 1800000,
        "headerTimeout": 120000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3.6-moe:35b-a3b": {
          "name": "Qwen3.6 MoE 35B"
        },
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.8-dflash2:27b": {
          "name": "Qwen3.8 27B (DFlash 2 draft)"
        },
        "nemotron3.5-bolt-dflash-flash:e4b": { 
          "name": "NVIDIA-Nemotron-3.5-Bolt-E4B — DFlash Flash"
        },
        "gemma4-it:e4b": {
          "name": "Gemma 4 IT E4B"
        },
        "qwen3.8-mtp:27b": {
          "name": "Qwen3.8 27B "
        }
      }
    }
  },
  "agent": {
    "title": {
      "disable": false
    }
  },
    "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  ]  
}
