[Unit]
Description=NPUStackedCoder container stack (FastFlowLM, OpenWebUI, OpenCode)
Documentation=file:%h/npu-llm/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust WorkingDirectory if you cloned the repo somewhere other than
# ~/npu-llm. The compose file lives in src/ until PUB-007 flattens the layout.
WorkingDirectory=%h/npu-llm/src
ExecStartPre=/usr/bin/podman compose -f %h/npu-llm/src/docker-compose.yml down
ExecStart=/usr/bin/podman compose -f %h/npu-llm/src/docker-compose.yml up
ExecStop=/usr/bin/podman compose -f %h/npu-llm/src/docker-compose.yml down
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=default.target
