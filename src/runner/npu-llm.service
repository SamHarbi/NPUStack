[Unit]
Description=FastFlowLM Server Container
After=network.target

[Service]
Type=simple
User=myappuser
Group=myappuser
WorkingDirectory=/var/lib/mydaemon
ExecStart=/usr/local/bin/mydaemon-binary --option
Restart=on-failure
RestartSec=5s
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
