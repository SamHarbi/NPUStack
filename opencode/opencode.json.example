{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "fastflowlm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FastFlowLM (local NPU)",
      "options": {
        "baseURL": "http://fastflowlm:52625/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "qwen3.6-moe:35b-a3b": {
          "name": "Qwen3.6 MoE 35B (local NPU)"
        }
      }
    }
  }
}
