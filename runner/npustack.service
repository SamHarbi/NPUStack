[Unit]
Description=NPUStack container stack (FastFlowLM, OpenWebUI, OpenCode)
Documentation=file:%h/npu-llm/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust WorkingDirectory if you cloned the repo somewhere other than
# ~/npu-llm.
WorkingDirectory=%h/npu-llm
ExecStartPre=/usr/bin/podman compose -f %h/npu-llm/compose.yaml down
ExecStart=/usr/bin/podman compose -f %h/npu-llm/compose.yaml up
ExecStop=/usr/bin/podman compose -f %h/npu-llm/compose.yaml down
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=default.target
